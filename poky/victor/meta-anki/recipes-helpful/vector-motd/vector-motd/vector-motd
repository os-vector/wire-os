#!/bin/sh

if [ -t 1 ] && [ -n "$TERM" ] && [ "$TERM" != "dumb" ]; then
	RESET=$(printf '\033[0m')
	BOLD=$(printf '\033[1m')
	GREEN=$(printf '\033[38;5;43m')
	L1=$(printf '\033[1;38;5;196m')
	L2=$(printf '\033[1;38;5;208m')
	L3=$(printf '\033[1;38;5;220m')
	L4=$(printf '\033[1;38;5;46m')
	L5=$(printf '\033[1;38;5;39m')
	L6=$(printf '\033[1;38;5;129m')
else
	RESET= BOLD= GREEN= L1= L2= L3= L4= L5= L6=
fi

NAME=$(getprop ro.build.os.cfw.prettyname)
VERSION=$(getprop ro.anki.version)

IP=$(ip -4 -o addr show wlan0 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')
[ -n "$IP" ] || IP="not connected"

VHOST=$(cat /data/etc/vhostname 2>/dev/null)
[ -n "$VHOST" ] && VHOST="$VHOST.local" || VHOST="not set (see vhostname)"

MEM=$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2}
	END{ if (t) printf "%dM / %dM", (t-a)/1024, t/1024 }' /proc/meminfo)

usage() {
	df -h "$1" 2>/dev/null | awk 'END{ if (NF>3) print $3 " / " $2 }'
}

printf '\n'
printf 'Welcome to %s%s%s%s!\n'       "$BOLD" "$GREEN" "$NAME" "$RESET"
printf '\n'
printf '%sOS:%s %s %s\n'              "$L1" "$RESET" "$NAME" "$VERSION"
printf '%sIP:%s %s\n'                 "$L2" "$RESET" "$IP"
printf '%sAlt hostname:%s %s\n'       "$L3" "$RESET" "$VHOST"
printf '%sMemory:%s %s used\n'             "$L4" "$RESET" "$MEM"
printf '%sStorage (/):%s %s used\n'        "$L5" "$RESET" "$(usage /)"
printf '%sStorage (/data):%s %s used\n'    "$L6" "$RESET" "$(usage /data)"
printf '\n'
