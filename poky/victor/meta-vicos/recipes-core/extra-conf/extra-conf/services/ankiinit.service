[Unit]
SourcePath=/etc/initscripts/ankiinit
Description=Anki Post Boot Service
Requires=partition-links.service leproperties.service mount-data.service
After=partition-links.service leproperties.service mount-data.service

[Service]
Type=oneshot
IgnoreSIGPIPE=no
KillMode=process
RemainAfterExit=yes
ExecStart=/etc/initscripts/ankiinit

[Install]
WantedBy=multi-user.target
