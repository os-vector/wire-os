#!/bin/bash

NAME_FILE=/data/etc/vhostname

usage() {
	echo "usage: vhostname [name]    set the secondary hostname (reachable as name.local)"
	echo "       vhostname           show the secondary hostname"
	echo "       vhostname -d        remove the secondary hostname"
	exit 1
}

apply() {
	systemctl restart vhostname-publish.service
}

case "$1" in
"")
	cat "$NAME_FILE" 2>/dev/null
	exit 0
	;;
-h|--help)
	usage
	;;
-d)
	rm -f "$NAME_FILE"
	apply
	exit 0
	;;
esac

[ $# -eq 1 ] || usage

NAME=${1%.local}

case "$NAME" in
""|-*|*-|*[!A-Za-z0-9-]*)
	echo "$NAME is not a valid hostname (letters, digits and - only)"
	exit 1
	;;
esac

if [ ${#NAME} -gt 63 ]; then
	echo "hostname must be 63 characters or less"
	exit 1
fi

if [ "$(echo "$NAME" | tr 'A-Z' 'a-z')" = "$(hostname | tr 'A-Z' 'a-z')" ]; then
	echo "'$NAME' is already this robot's hostname"
	exit 1
fi

mkdir -p "$(dirname "$NAME_FILE")"
echo "$NAME" > "$NAME_FILE.tmp" && mv "$NAME_FILE.tmp" "$NAME_FILE"
sync
apply
echo "this robot is now also reachable at $NAME.local"
